{
  "name": "{{ extension_name|lower|replace(' ', '-')}}",
  "version": "0.0.0",
  "description": "{{ extension_description }}",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.2",
  "repository": {
    "type": "git",
    "url": "git+{{ github_url }}.git"
  },
  "author": "Bruno Paz <oss@brunopaz.dev>",
  "license": "MIT",
  "bugs": {
    "url": "{{ github_url }}/issues"
  },
  "homepage": "{{ github_url }}#readme",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm run gschema:compile && tsc",
    "watch": "tsc --watch",
    "gschema:compile": "glib-compile-schemas schemas",
    "pack": "bash scripts/pack.sh",
    "ext:install": "bash scripts/install.sh",
    "ext:enable": "gnome-extensions enable my-extension@example.com",
    "clean": "rimraf dist my-extension.zip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "@girs/gjs": "4.6.0",
    "@girs/gnome-shell": "^50.0.0"
  }
}